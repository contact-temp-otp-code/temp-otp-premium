rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin email cố định
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'tuquangnamht2007@gmail.com';
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if request.auth != null && request.auth.uid == userId;
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }
    
    // Rent history
    match /rentHistory/{doc} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.uid);
      allow create: if request.auth != null;
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.uid);
    }
    
    // Recharges
    match /recharges/{doc} {
      allow read: if isAdmin();
      allow write: if request.auth != null;
      allow update: if isAdmin();
    }
    
    // Services
    match /services/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}